# Illustrious Lexicon is 100% client-side and offline-capable.
# No API keys or external secrets are required to run or build the application.

# Optional: Dev server URL used only when running Electron against Vite locally (`npm run electron:dev`)
# VITE_DEV_SERVER_URL="http://localhost:3000"

# Optional: Disable Electron Builder code-signing auto-discovery for unsigned local Windows `.exe` builds
# CSC_IDENTITY_AUTO_DISCOVERY=false
