{
  "name": "illustrious-lexicon",
  "productName": "Illustrious Lexicon",
  "private": true,
  "version": "3.0.0",
  "description": "High-density Booru-style tag lexicon and one-click prompt composer for SDXL Illustrious anime diffusion models.",
  "author": "Illustrious Lexicon Contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/MeanGreenz/Booru-Lexicon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeanGreenz/Booru-Lexicon.git"
  },
  "bugs": {
    "url": "https://github.com/MeanGreenz/Booru-Lexicon/issues"
  },
  "keywords": [
    "booru",
    "danbooru",
    "sdxl",
    "illustrious",
    "stable-diffusion",
    "prompt-composer",
    "tag-lexicon",
    "anime-diffusion"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "export:csv": "npx tsx scripts/export-csv.ts",
    "build:standalone": "npx tsx scripts/export-csv.ts && vite build && node scripts/build-standalone.mjs",
    "electron:dev": "electron .",
    "dist:win": "vite build && npx electron-builder --win portable nsis",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
   }
}
