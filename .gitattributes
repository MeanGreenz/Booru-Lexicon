# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Force CRLF for Windows batch scripts so cmd.exe always executes them cleanly
*.bat text eol=crlf
*.cmd text eol=crlf

# Force LF for shell scripts
*.sh text eol=lf

# Mark generated bundles, CSV exports, and lockfiles as generated so GitHub's
# repository language bar accurately reports TypeScript instead of HTML
release/Illustrious-Lexicon-Standalone.html linguist-generated=true
*.csv linguist-generated=true
package-lock.json linguist-generated=true
bun.lock linguist-generated=true
